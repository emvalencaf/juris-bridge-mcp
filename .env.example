# Comma-separated Bearer keys; the server refuses to start with none.
JURIS_BRIDGE_SERVER_API_KEYS=
JURIS_BRIDGE_SERVER_HOST=0.0.0.0
JURIS_BRIDGE_SERVER_PORT=8000
JURIS_BRIDGE_HTTP_TIMEOUT_SECONDS=15
JURIS_BRIDGE_HTTP_MAX_RETRIES=2
JURIS_BRIDGE_HTTP_MAX_WAIT_SECONDS=5
JURIS_BRIDGE_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
JURIS_BRIDGE_DATAJUD_API_KEY=
JURIS_BRIDGE_DATAJUD_DEFAULT_COURT_INDEX=api_publica_tjsp
JURIS_BRIDGE_DATAJUD_TIMEOUT_SECONDS=20
JURIS_BRIDGE_DATAJUD_REQUESTS_PER_MINUTE=120
# Seconds a found Case is kept in memory (short: DataJud terms limit storing derived data).
JURIS_BRIDGE_DATAJUD_CACHE_TTL_SECONDS=300
JURIS_BRIDGE_DJEN_BASE_URL=https://comunicaapi.pje.jus.br
JURIS_BRIDGE_DJEN_TIMEOUT_SECONDS=20
JURIS_BRIDGE_DJEN_REQUESTS_PER_MINUTE=15
JURIS_BRIDGE_BNP_BASE_URL=https://pangeabnp.pdpj.jus.br/api/v1
JURIS_BRIDGE_BNP_TIMEOUT_SECONDS=30
JURIS_BRIDGE_BNP_REQUESTS_PER_MINUTE=60
# Seconds a BNP answer is kept in memory (the BNP is updated about twice a month).
JURIS_BRIDGE_BNP_CACHE_TTL_SECONDS=3600
JURIS_BRIDGE_BNP_CACHE_MAX_ENTRIES=256
JURIS_BRIDGE_SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
JURIS_BRIDGE_SENADO_TIMEOUT_SECONDS=20
JURIS_BRIDGE_SENADO_REQUESTS_PER_MINUTE=300
# Seconds a search is kept in memory so its pages cost one request, and how many at most.
JURIS_BRIDGE_SENADO_CACHE_TTL_SECONDS=300
JURIS_BRIDGE_SENADO_CACHE_MAX_ENTRIES=64
JURIS_BRIDGE_PLANALTO_BASE_URL=https://www.planalto.gov.br/ccivil_03
JURIS_BRIDGE_PLANALTO_TIMEOUT_SECONDS=30
JURIS_BRIDGE_PLANALTO_REQUESTS_PER_MINUTE=60
# Câmara Legin, the norm text fallback: its URL is found through the LexML URN page.
JURIS_BRIDGE_LEGIN_LEXML_BASE_URL=https://www.lexml.gov.br
JURIS_BRIDGE_LEGIN_TIMEOUT_SECONDS=30
JURIS_BRIDGE_LEGIN_REQUESTS_PER_MINUTE=12
JURIS_BRIDGE_LOG_SERVICE=juris-bridge-mcp
# JURIS_BRIDGE_LOG_COMMIT_HASH=
# JURIS_BRIDGE_LOG_REGION=  (falls back to AWS_REGION)
# Seconds a parsed norm text is kept in memory, and how many norms at most.
JURIS_BRIDGE_PLANALTO_CACHE_TTL_SECONDS=3600
JURIS_BRIDGE_PLANALTO_CACHE_MAX_ENTRIES=16
# Evaluation (evals/): Gemini keys, models and the limits shown in AI Studio for your project.
# GEMINI_API_KEYS is comma-separated and reserved for key rotation; GEMINI_API_KEY is enough.
GEMINI_API_KEY=
GEMINI_API_KEYS=
EVALS_AGENT_MODEL=
EVALS_JUDGE_MODEL=
EVALS_CALIBRATION_MODEL=
EVALS_REQUESTS_PER_MINUTE=
EVALS_TOKENS_PER_MINUTE=
EVALS_REQUESTS_PER_DAY=
EVALS_MAX_REQUESTS_PER_RUN=
